---
import Icon from './Icon.astro';
---

<section class="box skills">
	<div class="stack gap-2 lg:gap-4">
		{/* Deep Stack: code icon better conveys engineering depth */}
		<Icon icon="code" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Deep Stack</h2>
		<p>I cut my teeth via deep stack distributed systems development.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		{/* DevOps: rocket-launch suits shipping velocity and automation */}
		<Icon icon="rocket-launch" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Developer Operations</h2>
		<p>A passion for developer tooling and automation.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		{/* Leadership: x&o's suggests strategy expert */}
		<Icon icon="strategy" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Leader</h2>
		<p>I have earned the respect of my peers and I love sharing knowledge and experience.</p>
	</div>
</section>

<style>
	.box {
		border: 1px solid var(--accent-overlay);
		border-radius: 0.75rem;
		padding: 1.5rem;
		/* Glassmorphism */
		background-color: hsla(var(--gray-999-basis), 0.55);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: var(--glow-sm), var(--shadow-sm);
		transition: box-shadow var(--theme-transition), border-color var(--theme-transition);
	}

	.box:hover {
		border-color: var(--accent-regular);
		box-shadow: var(--glow-md);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.skills h2 {
		font-size: var(--text-lg);
		color: var(--accent-dark);
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.skills p {
		color: var(--gray-400);
	}

	/* Icon glow on hover */
	.skills .stack:hover :global(svg) {
		filter: drop-shadow(0 0 8px var(--accent-regular));
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.5rem;
			padding: 2.5rem;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 5rem;
		}

		.skills h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
